<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1115"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never"
    tools:context=".ui.FragmentTimer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ====================================== -->
        <!-- 1. HEADER -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- App Logo -->
            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_logo_circle"
                android:gravity="center"
                android:text="◈"
                android:textColor="#10C995"
                android:textSize="21sp" />

            <!-- App Name -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="FocusGuard"
                android:textColor="#F5F6F7"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- PRO Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_pro_badge"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="✦ PRO"
                android:textColor="#10C995"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ====================================== -->
        <!-- 2. MOTIVATIONAL QUOTE -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/quoteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_quote_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❝"
                android:textColor="#10C995"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="Deep work is the superpower of the 21st century. — Cal Newport"
                android:textColor="#B3BAC2"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ====================================== -->
        <!-- 3. CIRCULAR TIMER -->
        <!-- ====================================== -->

        <FrameLayout
            android:id="@+id/timerContainer"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="18dp">

            <!-- Circular Progress Indicator -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/timerProgress"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:max="1500"
                android:progress="1500"
                app:indeterminate="false"
                app:indicatorColor="#10C995"
                app:indicatorSize="250dp"
                app:trackColor="#252A2E"
                app:trackThickness="8dp" />

            <!-- Timer Center Content -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Timer Value -->
                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:text="25:00"
                    android:textColor="#F5F6F7"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <!-- Timer Mode -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        />

                    <TextView
                        android:id="@+id/tvTimerMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Deep Work"
                        android:textColor="#858B91"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>


        <!-- ====================================== -->
        <!-- 4. FOCUS TASK INPUT -->
        <!-- ====================================== -->

        <EditText
            android:id="@+id/etFocusTask"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_focus_input"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="10dp"
            android:drawableTint="#858B91"
            android:hint="What are you focusing on?"
            android:inputType="textCapSentences"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#F5F6F7"
            android:textColorHint="#858B91"
            android:textSize="13sp" />


        <!-- ====================================== -->
        <!-- 5. FOCUS MODES -->
        <!-- ====================================== -->

        <HorizontalScrollView
            android:id="@+id/modeScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/modeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Coding Mode: Selected -->
                <TextView
                    android:id="@+id/btnCoding"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_mode_selected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="⌘  Coding"
                    android:textColor="#10C995"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Study Mode -->
                <TextView
                    android:id="@+id/btnStudy"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mode_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="✎  Study"
                    android:textColor="#A5ABB3"
                    android:textSize="12sp" />

                <!-- Reading Mode -->
                <TextView
                    android:id="@+id/btnReading"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mode_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="▤  Reading"
                    android:textColor="#A5ABB3"
                    android:textSize="12sp" />

                <!-- Work Mode -->
                <TextView
                    android:id="@+id/btnWork"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mode_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="✦  Work"
                    android:textColor="#A5ABB3"
                    android:textSize="12sp" />

            </LinearLayout>

        </HorizontalScrollView>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartSession"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="▶   Start Focus Session"
            android:textAllCaps="false"
            android:textColor="#071B16"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#10C995"
            app:cornerRadius="28dp"
            app:elevation="6dp"
            app:rippleColor="#66FFFFFF" />

    </LinearLayout>

</ScrollView>
