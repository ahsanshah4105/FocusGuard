<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1115"
    tools:context=".ui.FragmentHistory">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="History"
                    android:textColor="#F5F6F7"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnHistoryFilter"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_history_icon_button"
                    android:gravity="center"
                    android:text="☷"
                    android:textColor="#A5ABB3"
                    android:textSize="17sp"/>

            </LinearLayout>

            <!-- SUMMARY CARD -->
            <LinearLayout
                android:id="@+id/focusSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical"
                android:padding="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="TOTAL FOCUS TODAY"
                        android:textColor="#7F8B98"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvFocusStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_streak_badge"
                        android:gravity="center"
                        android:paddingHorizontal="9dp"
                        android:text="●  4-Day Streak"
                        android:textColor="#10C995"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalFocusToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="2h 15m"
                    android:textColor="#F5F6F7"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <ProgressBar
                    android:id="@+id/focusGoalProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="9dp"
                    android:max="100"
                    android:progress="56"
                    android:progressDrawable="@drawable/progress_focus_goal"
                    android:indeterminate="false"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSessionCountToday"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4 sessions"
                        android:textColor="#87919B"
                        android:textSize="9sp"/>

                    <TextView
                        android:id="@+id/tvFocusGoal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal 4h · 56%"
                        android:textColor="#87919B"
                        android:textSize="9sp"/>

                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSessionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:listitem="@layout/item_history"/>

        </LinearLayout>

    </ScrollView>


</LinearLayout>
